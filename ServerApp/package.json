{
  "name": "pst-security-console",
  "version": "1.0.0",
  "private": true,
  "description": "PST 终端安全运营中心 - 数据接收与可视化大屏",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node --no-warnings server.js",
    "seed": "node --no-warnings test/seed.js",
    "build:exe": "pkg -t node22-win-x64 --compress GZip -o dist/PST-SecurityConsole.exe ."
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.26.1"
  }
}
